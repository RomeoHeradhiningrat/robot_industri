import math
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry



# Jalur labirin berdasarkan koordinat yang diberikan
LEFT_TRACK = [
    (0.80, 2.50),
    (2.35, 2.50),
    (2.35, 3.30),
    (3.40, 3.30),
    (3.20, 0.85),
    (7.40, 1.00),

    (6.90, 7.00),
    (6.42, 7.30),
    (6.41, 7.32),

    (5.00, 8.00),

    (4.00, 7.32),
    (3.80, 7.31),
    (3.50, 7.00),

    (3.30, 5.30),
    (2.90, 5.30),
    (2.50, 6.80),
    (3.00, 6.80),
    (1.50, 7.50),
    (0.30, 7.50),
    (0.25, 4.50)
]


class MazeSolver(Node):

    def __init__(self):
        super().__init__('maze_solver')

        self.cmd_pub = self.create_publisher(
            Twist, '/cmd_vel', 10
        )

        self.odom_sub = self.create_subscription(
            Odometry,
            '/odom',
            self.odom_callback,
            10
        )

        self.x = None
        self.y = None
        self.yaw = None

        self.index = 0
        self.finished = False

        # Parameter gerakan
        self.tolerance = 0.10
        self.max_speed = 1.0
        self.max_angular = 1.5
        self.k_linear = 1.5
        self.k_angular = 2.2

        self.timer = self.create_timer(
            0.05, self.control_loop
        )

        self.get_logger().info(
            'Maze Solver aktif. Menunggu data /odom...'
        )

    def odom_callback(self, msg):
        self.x = msg.pose.pose.position.x
        self.y = msg.pose.pose.position.y

        q = msg.pose.pose.orientation

        sin_yaw = 2.0 * (q.w * q.z + q.x * q.y)
        cos_yaw = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)

        self.yaw = math.atan2(sin_yaw, cos_yaw)

    @staticmethod
    def normalize_angle(angle):
        return math.atan2(
            math.sin(angle), math.cos(angle)
        )

    def stop_robot(self):
        msg = Twist()
        self.cmd_pub.publish(msg)

    def control_loop(self):
        if self.x is None or self.y is None or self.yaw is None:
            return

        if self.finished:
            self.stop_robot()
            return

        # Ambil waypoint tujuan
        target_x, target_y = LEFT_TRACK[self.index]

        dx = target_x - self.x
        dy = target_y - self.y
        distance = math.hypot(dx, dy)

        # Waypoint tercapai
        if distance < self.tolerance:
            self.get_logger().info(
                f'Waypoint {self.index + 1}/{len(LEFT_TRACK)} '
                f'tercapai: x={self.x:.2f}, y={self.y:.2f}'
            )

            self.index += 1

            if self.index >= len(LEFT_TRACK):
                self.finished = True
                self.stop_robot()
                self.get_logger().info(
                    'FINISH! Robot telah menyelesaikan jalur.'
                )
                return

            return

        # Sudut menuju waypoint
        target_yaw = math.atan2(dy, dx)
        yaw_error = self.normalize_angle(
            target_yaw - self.yaw
        )

        cmd = Twist()

        # Putar dahulu jika arah robot terlalu melenceng
        if abs(yaw_error) > 0.20:
            cmd.linear.x = 0.0
            cmd.angular.z = max(
                -self.max_angular,
                min(
                    self.max_angular,
                    self.k_angular * yaw_error
                )
            )

        else:
            # Bergerak maju sambil mengoreksi arah
            speed = min(
                self.max_speed,
                self.k_linear * distance
            )

            # Kurangi kecepatan ketika arah belum lurus
            speed *= max(0.0, math.cos(yaw_error))

            cmd.linear.x = speed
            cmd.angular.z = max(
                -self.max_angular,
                min(
                    self.max_angular,
                    self.k_angular * yaw_error
                )
            )

        self.cmd_pub.publish(cmd)


def main(args=None):
    rclpy.init(args=args)

    node = MazeSolver()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.stop_robot()
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
